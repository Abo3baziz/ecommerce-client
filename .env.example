# Copy to .env.local (dev) or set in the hosting dashboard (Vercel).

# Browser-facing API base. Keep it RELATIVE (/api/v1) so browser calls are
# same-origin and session cookies stay first-party (SameSite=Lax works).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side origin the Next.js rewrite proxy forwards /api/v1/* to.
# Dev default: http://localhost:3000
# Production (Vercel): https://<your-api>.up.railway.app — no trailing slash.
API_ORIGIN=http://localhost:3000
