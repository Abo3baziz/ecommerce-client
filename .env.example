# Copy to .env.local (dev) or set in the hosting dashboard (Vercel).

# Browser-facing API base. Keep it RELATIVE (/api/v1) so browser calls are
# same-origin and session cookies stay first-party (SameSite=Lax works).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side origin the Next.js rewrite proxy forwards /api/v1/* to.
# Dev default: http://localhost:3000
# Production (Vercel): https://<your-api>.up.railway.app — no trailing slash.
API_ORIGIN=http://localhost:3000

# Public site URL used for SEO: canonical links, sitemap, Open Graph.
# Must match the deployed origin (no trailing slash).
# Production: https://ecommerce-storefront-ashy.vercel.app
# For local dev you may override to http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://ecommerce-storefront-ashy.vercel.app

# Public read-only demo mode (recruiter showcase). Set to "true" to build the
# app so anonymous visitors can open /admin and explore the dashboard
# read-only: the layout shows a demo banner, mutation buttons are hidden, and
# mutating /admin/* requests are blocked client-side (the backend — with
# ENABLE_DEMO_MODE=true — independently enforces the same restrictions).
# Real signed-in admins keep full access while the flag is on.
# Must be set at build time (NEXT_PUBLIC_ vars are inlined into the bundle).
NEXT_PUBLIC_DEMO_MODE=false
